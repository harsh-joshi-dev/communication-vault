<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext (HTTP) for localhost/emulator if needed -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">192.168.1.16</domain>
    </domain-config>
    <!-- Allow HTTPS for production backend -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">communication-vault.onrender.com</domain>
    </domain-config>
    <!-- Base config allows all HTTPS and HTTP traffic -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>

